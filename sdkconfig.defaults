CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_BLUFI_ENABLE=y
CONFIG_MBEDTLS_DHM_C=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Keep TLS handshake and certificate allocations in PSRAM on N8R2.
# The reference XiaoZhi project uses the same external allocator strategy.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_DYNAMIC_BUFFER is not set
# 上面这行必须保持关闭：DYNAMIC_BUFFER 会在握手结束后释放证书与私钥，下一次握手
# 得重新注册，而 WSS 断线重连正是反复握手。代价是握手峰值内存偏高，这部分已经由
# MBEDTLS_EXTERNAL_MEM_ALLOC 挪进 PSRAM 消化。
# 原先这里还有一行 CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y：它的 Kconfig 依赖
# MBEDTLS_DYNAMIC_BUFFER，父项关闭时该行会被静默丢弃、从未生效（连带
# MBEDTLS_DYNAMIC_FREE_CA_CERT 也一并失效）。留着只会让人以为握手内存已经省过。
# ESP32-S3 at 240 MHz gains no TLS throughput from hardware AES; software
# AES keeps TLS allocations in the external-memory allocator instead of the
# constrained internal DMA heap.
# CONFIG_MBEDTLS_HARDWARE_AES is not set
# LVGL 的内存走标准 malloc（见下方 CONFIG_LV_USE_CLIB_MALLOC=y），而
# LV_MEM_SIZE_KILOBYTES 只在 LV_USE_BUILTIN_MALLOC 下有效。原先这里写着 =32，
# 两者互斥、该值从未生效；删掉以免被当成"LVGL 堆限到 32 KB"去推理内存。
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=98304
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_AFE_INTERFACE_V1=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
# CONFIG_LV_FONT_SOURCE_HAN_SANS_SC_14_CJK is not set
# ui_cjk_font.c is a compressed LVGL font; enable its decoder.
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_GIF=y
CONFIG_LV_USE_SPINNER=y
CONFIG_LV_USE_CLIB_MALLOC=y
# CONFIG_LV_USE_BUILTIN_MALLOC is not set
# Keep UART0 available for the STC8H link; logs use USB Serial JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_CONSOLE_UART is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# The BluFi provisioning window expires on an xTimer callback (Tmr Svc task),
# which calls esp_blufi_adv_stop() -> NimBLE. The default 2048-byte software
# timer stack is too shallow for that call chain and stack-overflows into a
# panic reboot. Keep it at 4096 so the timer callback can stop advertising.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
# RX_BA_WIN 回到默认的 6。它原来是 4，连同接收缓冲一起被压掉过：当时在追“电台
# 一哑十几秒”，把内部 DMA 内存全往接收路径推。但窗口 4 意味着一次只能连续收
# 4 个帧，2.4G 一有干扰就得停下来重传，实际吞吐反而上不去。
# ESP-IDF 的约束是 静态+动态 >= 2*RX_BA_WIN，所以缓冲数跟着一起抬（6+12 >= 12）。
# 动态那 12 个走 PSRAM（CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y），不多吃内部 RAM。
CONFIG_ESP_WIFI_RX_BA_WIN=6
# 发送侧曾经为了给接收路径腾内部 DMA 内存被减到 8 个，现在恢复 16。理由是观测到
# 的反向证据：新建 TCP 连接成片超时（esp-tls 报 "[sock=54] select() timeout"，
# transport_base 32774，300 秒里 27 次），而已建立的连接仍能收数据——这不像对方
# 不搭理，更像 SYN 自己没发出去。8 个 1.6 KB 的 TX 缓冲在同时有下行大流量（每片
# 几十上百 KB 的 HLS）时是不够的：ACK 和新的 SYN 全在抢那几个位置。
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
# 主动关掉的短连接会在 TIME_WAIT 里挂 2×MSL。lwIP 默认 MSL=60 秒，于是一条连接
# 要占着本地 PCB 和上游 NAT 映射整整 120 秒。而电台 HLS 每 10 秒就是一条新连接
# （不做 keep-alive，理由见 radio_stream_service.c 的 hls_open_segment），光是
# 续片就能同时攒出 12 条 TIME_WAIT，再叠上 probe、天气、定位。实测路由器
# （192.168.1.10，手机热点级别）一满，新建连接就只会 select() 超时：日志里成对
# 出现 "[sock=56] select() timeout" + transport_base 32774，5 秒白等一次，两次
# 就把 STA 强制重连了。压到 6 秒（TIME_WAIT=12 秒）后同时挂着的只剩一两条。
CONFIG_LWIP_TCP_MSL=6000
CONFIG_ESP_WS_CLIENT_ENABLE_DYNAMIC_BUFFER=y
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=2000
# HLS 电台（央广中国之声）的分片是 TS 容器装 AAC。这两个开关缺任何一个，电台都会
# 连得上、播放列表也解析通过，然后一片都解不出声——最难查的那种失败。两者在组件的
# Kconfig 里默认都是 y，写进 defaults 是为了重新生成 sdkconfig 时不会静默回退。
CONFIG_AUDIO_DECODER_AAC_SUPPORT=y
CONFIG_AUDIO_SIMPLE_DEC_TS_SUPPORT=y
