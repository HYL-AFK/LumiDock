# macOS
.DS_Store
.AppleDouble
.LSOverride

# Directory metadata
.directory

# Temporary files
*~
*.swp
*.swo
*.bak
*.tmp

# Log files
*.log

# Build artifacts and directories
**/build/
build/
*.o
*.a
*.out
*.exe # For any host-side utilities compiled on Windows

# ESP-IDF specific build outputs
*.bin
# 例外：main/assets 下的 .bin 是构建必需的源资产，不是编译产物。
# 整点报时的 Opus 素材（prompt_chime_hour_*_opus.bin）就是这种格式，由
# scripts/generate_prompt_tones.py 生成，main/CMakeLists.txt 用 EMBED_FILES
# 直接嵌进固件。被 *.bin 挡掉的话，clone 下来一编译就找不到文件。
!main/assets/**/*.bin
*.elf
*.map
flasher_args.json # Generated in build directory
sdkconfig.old
sdkconfig

# ESP-IDF dependencies
# For older versions or manual component management
/components/.idf/
**/components/.idf/
# For modern ESP-IDF component manager
managed_components/
# If ESP-IDF tools are installed/referenced locally to the project
.espressif/

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt
CTestTestfile.cmake

# Python environment files
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/

# Virtual environment folders
venv/
.venv/
env/

# Language Servers
.clangd/
.ccls-cache/
compile_commands.json

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini

# Local assistant state, test captures, and generated previews
.codex/
.superpowers/
tmp/
outputs/
preview/

# Local firmware and full-flash backups
# The full-flash dump carries the WiFi credentials and device keys, so the whole
# directory stays out of the repository instead of relying on the *.bin rule alone.
backup_20261026/

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio
